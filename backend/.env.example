# Copia este archivo como ".env" y rellena los valores reales.
# El ".env" real NO se sube al repositorio. Los valores se piden a
# los desarrolladores del proyecto.

# Clave para los endpoints de desarrollador (minimo 16 caracteres)
INCLUSIVE_DEV_KEY=

# Clave del usuario 'inclusive_backend' del broker MQTT (la usa el backend)
INCLUSIVE_MQTT_PASSWORD=

# Clave del usuario 'inclusive_esp32' del broker MQTT (la usa el simulador y las placas ESP32)
INCLUSIVE_ESP32_PASSWORD=

# Opcional: direccion del broker si no es este mismo equipo
# INCLUSIVE_MQTT_HOST=192.168.60.8